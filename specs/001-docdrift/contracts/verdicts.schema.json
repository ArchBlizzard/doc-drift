{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docdrift/verdicts.schema.json",
  "title": "DocDrift system output (shared by baseline, baseline_plus, and agent)",
  "type": "object",
  "required": ["case_id", "system", "model_id", "claims", "usage", "wall_s"],
  "additionalProperties": false,
  "properties": {
    "case_id": { "type": "string", "pattern": "^case_[0-9]{2}$" },
    "system": { "enum": ["baseline", "baseline_plus", "baseline_stratified", "agent"] },
    "model_id": { "type": "string", "description": "resolved model ID from response metadata" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quoted_span", "verdict"],
        "additionalProperties": false,
        "properties": {
          "quoted_span": { "type": "string", "minLength": 1, "description": "exact substring of datacard.md" },
          "span_start": { "type": "integer", "minimum": 0 },
          "span_end": { "type": "integer", "minimum": 1 },
          "verdict": { "enum": ["holds", "violated", "unverifiable"] },
          "reason": { "enum": ["prose", "check_failed", "execution_error"] },
          "claimed": { "type": "string" },
          "computed": { "type": "string" },
          "evidence_rows": { "type": "array", "maxItems": 5, "items": { "type": "object" } }
        }
      }
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "wall_s": { "type": "number", "minimum": 0 }
  }
}
